From 1f1fedd0c0b10459d125d42765e63ae896bacb8d Mon Sep 17 00:00:00 2001
From: Reid Smythe <rwsmythe@gmail.com>
Date: Tue, 10 Nov 2026 22:54:07 -1000
Subject: [PATCH] avcodec/videotoolboxenc: preserve frame duration in output
 packets

The wrapper drops input frame durations, allowing the muxer to substitute
an average duration and alter VFR timing. Carry positive durations through
the existing sourceFrameCtx node to the corresponding packet, including
delayed and flushed output. Preserve zero for unknown durations and leave
CoreMedia timing unchanged.

Clearwater WP6.5 DR-163.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 libavcodec/videotoolboxenc.c | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/libavcodec/videotoolboxenc.c b/libavcodec/videotoolboxenc.c
index de52923..7345e0d 100644
--- a/libavcodec/videotoolboxenc.c
+++ b/libavcodec/videotoolboxenc.c
@@ -239,6 +239,7 @@ typedef struct BufNode {
     CMSampleBufferRef cm_buffer;
     ExtraSEI sei;
     AVBufferRef *frame_buf;
+    int64_t duration;
     struct BufNode* next;
 } BufNode;
 
@@ -411,7 +412,8 @@ static void vtenc_reset(VTEncContext *vtctx)
     }
 }
 
-static int vtenc_q_pop(VTEncContext *vtctx, bool wait, CMSampleBufferRef *buf, ExtraSEI *sei)
+static int vtenc_q_pop(VTEncContext *vtctx, bool wait, CMSampleBufferRef *buf,
+                       ExtraSEI *sei, int64_t *duration)
 {
     BufNode *info;
 
@@ -450,6 +452,8 @@ static int vtenc_q_pop(VTEncContext *vtctx, bool wait, CMSampleBufferRef *buf, E
 
     *buf = info->cm_buffer;
     info->cm_buffer = NULL;
+    if (duration)
+        *duration = info->duration;
     if (sei && *buf) {
         *sei = info->sei;
         info->sei = (ExtraSEI) {0};
@@ -2503,6 +2507,7 @@ static int vtenc_send_frame(AVCodecContext *avctx,
     }
 #endif
 
+    node->duration = frame->duration > 0 ? frame->duration : 0;
     time = CMTimeMake(frame->pts * avctx->time_base.num, avctx->time_base.den);
     status = VTCompressionSessionEncodeFrame(
         vtctx->session,
@@ -2543,6 +2548,7 @@ static av_cold int vtenc_frame(
     int status;
     CMSampleBufferRef buf = NULL;
     ExtraSEI sei = {0};
+    int64_t duration = 0;
 
     if (frame) {
         status = vtenc_send_frame(avctx, vtctx, frame);
@@ -2579,7 +2585,7 @@ static av_cold int vtenc_frame(
         goto end_nopkt;
     }
 
-    status = vtenc_q_pop(vtctx, !frame, &buf, &sei);
+    status = vtenc_q_pop(vtctx, !frame, &buf, &sei, &duration);
     if (status) goto end_nopkt;
     if (!buf)   goto end_nopkt;
 
@@ -2588,6 +2594,7 @@ static av_cold int vtenc_frame(
     CFRelease(buf);
     if (status) goto end_nopkt;
 
+    pkt->duration = duration;
     *got_packet = 1;
     return 0;
 
@@ -2670,7 +2677,7 @@ static int vtenc_populate_extradata(AVCodecContext   *avctx,
         goto pe_cleanup;
     }
 
-    status = vtenc_q_pop(vtctx, 0, &buf, NULL);
+    status = vtenc_q_pop(vtctx, 0, &buf, NULL, NULL);
     if (status) {
         av_log(avctx, AV_LOG_ERROR, "popping: %d\n", status);
         goto pe_cleanup;
-- 
